# Backend environment variables
# Copy to .env and fill in values

# Server
API_HOST=0.0.0.0
PORT=8000

# Database (SQLite for local, Postgres URL for Railway)
DATABASE_URL=sqlite:///./polska_leads.db

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Autonomous background engine
AUTO_BACKGROUND_ENABLED=true
AUTO_BACKGROUND_INTERVAL_SECONDS=300
AUTO_BACKGROUND_LEADS_LIMIT=12
AUTO_BACKUP_EVERY_CYCLES=6
AUTO_BACKUP_KEEP_LATEST=20
AUTO_SELF_HEAL_STALLED_PIPELINE=true
