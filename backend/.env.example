# Backend environment variables
# Copy to .env and fill in values

# Server (0.0.0.0 exposes the API on all container interfaces)
API_HOST=0.0.0.0
PORT=8000

# Database (Neon PostgreSQL with SSL; copy the real secret into .env locally)
DATABASE_URL=******HOST/DB_NAME?sslmode=require&channel_binding=require

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
