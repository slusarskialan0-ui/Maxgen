# Backend environment variables
# Copy to .env and fill in values

# Server
API_HOST=0.0.0.0
PORT=8000

# Database (SQLite local fallback; for production set PostgreSQL URL from Supabase/Neon)
# Example: DATABASE_URL=******host:5432/dbname
DATABASE_URL=sqlite:///./polska_leads.db

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# B2B scraper targets (comma-separated listing pages)
B2B_SCRAPER_URLS=
B2B_SCRAPER_TIMEOUT=25

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=900

# Telegram command center
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
